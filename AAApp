watch: {
    nav_context: {
        async handler(newVal) {
            if (
                this.current_screen === "predisclosure_app" &&
                newVal.context === "new"
            ) {
                this.reset_form();
                return;
            }

            if (
                this.current_screen === "predisclosure_app" &&
                (
                    newVal.context === "edit" ||
                    newVal.context === "template"
                )
            ) {
                this.setup_edit_context();

                await this.get_predisclosure_lines(
                    this.selected_predisclosure.predisclosure_id
                );

                /*
                 * Load products for the selected product category.
                 */
                await this.load_products();

                /*
                 * SDA Partner Levels are required only for
                 * PARTNER disclosure type.
                 */
                const disclosure_type = String(
                    this.selected_predisclosure?.predisclosure_type ?? ""
                )
                    .trim()
                    .toUpperCase();

                if (disclosure_type === "PARTNER") {
                    await this.load_sda_partner_levels();
                } else {
                    this.sda_partner_levels = [];
                }

                /*
                 * Template mode converts existing lines into
                 * new temporary lines.
                 */
                if (newVal.context === "template") {
                    this.lines.forEach(line => {
                        line.id = "temp";

                        line.product_search = "";

                        line.products = (line.products || []).map(
                            product =>
                                typeof product === "object"
                                    ? product.id
                                    : product
                        );

                        line.sda_partner_level = (
                            line.sda_partner_level || []
                        ).map(
                            sda =>
                                typeof sda === "object"
                                    ? sda.id
                                    : sda
                        );

                        line.sda_partner_level_search = "";
                    });
                }
            }
        },

        deep: true,
    },
},










async load_predisclosure(id) {
    this.loading = true;

    const response = await fetch(
        `/predisclosuremgt/api/v1/predisclosure/${id}/`
    );

    const data = await response.json();

    this.selected_predisclosure = data;

    /*
     * Load SDA levels only for Partner disclosure.
     */
    if (
        this.selected_predisclosure?.predisclosure_type === "PARTNER"
    ) {
        await this.load_sda_partner_levels();
    }

    this.loading = false;
}







async paste_lines_from_excel(line_items, index, event) {
    this.loading = true;

    const text = event.clipboardData.getData("text/plain");

    if (!text || !text.trim()) {
        this.loading = false;
        return;
    }

    const disclosure_type = String(
        this.selected_predisclosure?.predisclosure_type ?? ""
    )
        .trim()
        .toUpperCase();

    if (!disclosure_type) {
        this.show_notification(
            "Please select a Disclosure Type before pasting Excel data."
        );
        this.loading = false;
        return;
    }

    const copied_lines = text
        .trim()
        .split(/\r?\n/)
        .filter(line => line.trim() !== "");

    if (!copied_lines.length) {
        this.loading = false;
        return;
    }

    const headers = copied_lines[0]
        .split("\t")
        .map(header => header.trim());

    if (!this.validate_paste_column_count(headers.length)) {
        this.show_notification(
            "Invalid Excel template. Please paste the proper template data as per disclosure type selection."
        );
        this.loading = false;
        return;
    }

    const field_mapping = [];

    for (
        let column_index = 0;
        column_index < headers.length;
        column_index++
    ) {
        const header = headers[column_index];

        const field = Object.keys(this.line_fields).find(
            field_name =>
                this.line_fields[field_name].label
                    .trim()
                    .toLowerCase() === header.toLowerCase()
        );

        if (!field) {
            continue;
        }

        field_mapping.push({
            column_index,
            field,
        });
    }

    if (!field_mapping.length) {
        this.show_notification(
            "No valid Pre-Disclosure columns were found in the pasted Excel data."
        );
        this.loading = false;
        return;
    }

    let pasted_row_count = 0;

    for (
        let row_index = 1;
        row_index < copied_lines.length;
        row_index++
    ) {
        /*
         * New row defaults.
         *
         * Products and SDA are intentionally empty because
         * they are selected manually in the UI.
         */
        const row = {
            products: [],
            product_search: "",

            sda_partner_level: [],
            sda_partner_level_search: "",
        };

        /*
         * In edit mode this is a NEW database record.
         * create_new_lines() uses "temp" to identify
         * rows that need to be POSTed.
         */
        if (this.nav_context.context === "edit") {
            row.id = "temp";
        }

        const cells = copied_lines[row_index].split("\t");

        let has_value = false;

        for (const mapping of field_mapping) {
            let value = cells[mapping.column_index];

            if (value === undefined || value === null) {
                value = "";
            }

            value = String(value).trim();

            if (value) {
                has_value = true;
            }

            /*
             * Validate date fields.
             */
            if (
                this.line_fields[mapping.field]?.date &&
                value
            ) {
                value = this.validate_pasted_date(value);

                if (!value) {
                    this.show_notification(
                        `${this.line_fields[mapping.field].label}: invalid date. ` +
                        `Please enter a valid date.`
                    );
                    continue;
                }
            }

            /*
             * Validate allowed values.
             */
            if (
                value &&
                !this.validate_pasted_value(
                    mapping.field,
                    value
                )
            ) {
                continue;
            }

            row[mapping.field] = value;
        }

        /*
         * Ignore completely empty Excel rows.
         */
        if (!has_value) {
            continue;
        }

        /*
         * EDIT MODE
         *
         * Do NOT replace the existing DB line.
         * Insert the pasted row as an additional new row.
         */
        if (this.nav_context.context === "edit") {
            line_items.splice(
                index + pasted_row_count,
                0,
                row
            );

            this.changes.new_lines_count++;
        } else {
            /*
             * CREATE MODE
             *
             * Preserve the existing behavior.
             */
            if (pasted_row_count === 0) {
                line_items.splice(
                    index,
                    1,
                    row
                );
            } else {
                line_items.splice(
                    index + pasted_row_count,
                    0,
                    row
                );
            }
        }

        pasted_row_count++;
    }

    if (pasted_row_count > 0) {
        this.show_notification(
            `${pasted_row_count} account(s) pasted successfully. ` +
            "Please select the Product(s) and SDA Partner Level(s) manually for each account."
        );
    }

    this.loading = false;
},
