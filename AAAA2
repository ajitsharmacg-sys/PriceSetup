async update_ticket_status(status, comment, files = []) {

    this.loading = true;

    try {

        const formData = new FormData();

        formData.append(
            "ticket_number",
            this.selected_ticket.ticket_number
        );

        formData.append(
            "comment",
            comment || ""
        );

        formData.append(
            "status",
            status
        );

        for (const file of files) {
            formData.append("Upload_files", file);
        }

        const response = await postFormData(
            api_endpoints.ticketstatus,
            formData
        );

        if (!response.ok) {
            throw response;
        }

        await response.json();

        this.update_triggered++;

    }
    catch (error) {

        this.display_error(
            error,
            "Unable to update the Price Setup Request."
        );

    }
    finally {

        this.loading = false;

    }

}

async reject_salesops() {

    await this.update_ticket_status(
        "SALESOPS_REJECTED",
        this.confirm_comment,
        this.selected_files
    );

}

async send_to_pm() {

    await this.update_ticket_status(
        "PENDING_PM_VALIDATION",
        this.confirm_comment,
        this.selected_files
    );

}

async close_ticket() {

    await this.update_ticket_status(
        "CLOSED",
        this.confirm_comment,
        this.selected_files
    );

}

async approve_salesops() {

    await this.update_ticket_status(
        "PENDING_SETUP",
        this.confirm_comment,
        this.selected_files
    );

}

