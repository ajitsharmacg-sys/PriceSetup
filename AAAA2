                        @click="navigate('list_of_requests')">

                        Requests

                    </a>

                </li>

                <li class="breadcrumb-item active">

                    [[ selected_ticket?.ticket_number ]]

                </li>

            </ol>

        </nav>

        <div class="row">

            <!-- LEFT -->
            <div class="col-12 col-lg-6">

                <vertical-table
                    :api_endpoint="ticket_detail_url"
                    :columns="ticket_header_columns"
                    v-model:data_refresh_trigger="update_triggered"
                    :custom_format="custom_format"
                    @on-item-update="(item) => {
                        selected_ticket = item;
                    }">

                    <template #actions="actionProps">

                        <tr>

                            <th>Actions</th>

                            <td>

                                <div class="btn-group">

                                    <!-- SalesOps validation -->
                                    <button
                                        v-if="can_salesops_validate(actionProps)"
                                        type="button"
                                        class="btn btn-sm btn-primary"
                                        @click="open_salesops_validation()">

                                        Validate

                                    </button>

                                    <!-- Setup -->
                                    <button
                                        v-if="can_setup(actionProps)"
                                        type="button"
                                        class="btn btn-sm btn-warning"
                                        @click="open_setup()">

                                        Update PM

                                    </button>

                                    <!-- PM validation -->
                                    <button
                                        v-if="can_pm_validate(actionProps)"
                                        type="button"
                                        class="btn btn-sm btn-primary"
                                        @click="open_pm_validation()">

                                        Validate

                                    </button>

                                </div>

                            </td>

                        </tr>

                    </template>

                </vertical-table>

            </div>

            <!-- RIGHT -->
            <div class="col-12 col-lg-6">

                <status-history
                    :api_endpoint="ticket_status_history_url"
                    v-model:data_refresh_trigger="update_triggered"
                    :custom_format="custom_format?.ticket_status">
                </status-history>

            </div>

        </div>

        <!-- LINE DETAILS -->

        <div class="mt-4">

            <h5 class="card-title">
                Price Setup Line Details
            </h5>

            <django-paged-table
                ref="lineTable"
                :api_endpoint="ticket_line_url"
                :columns="ticket_line_columns"
                :fixed_query_filter="line_filter">

            </django-paged-table>

        </div>

    </div>

</section>

