{% block ticket_info %}

<section
    id="ticket_info"
    class="section">

    <div v-if="current_screen === 'ticket_info'">

        <!-- Back -->
        <div class="fs-4 mb-3">

            <a href="#">
                <i
                    class="bi bi-arrow-left-circle-fill"
                    @click="navigate('list_of_requests')">
                </i>
            </a>

        </div>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">

            <ol class="breadcrumb">

                <li class="breadcrumb-item">

                    <a
