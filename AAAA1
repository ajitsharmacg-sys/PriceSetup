    const allowedStatuses =
        this.workflow.AIF_STATUS_GRAPH?.[aif.aif_status] || [];

    const hasPermission = roles.some(role =>
        this.user_role.includes(role)
    );

    return hasPermission ? allowedStatuses : [];
