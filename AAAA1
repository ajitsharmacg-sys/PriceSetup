    fetch("/aifmgmt/workflow/")
        .then(response => {
            if (!response.ok) {
                throw new Error(
                    `Failed to load AIF workflow: ${response.status}`
                );
            }
            return response.json();
        })
        .then(data => {
            this.workflow = data;
        })
        .catch(error => {
            console.error("Error loading AIF workflow:", error);
            this.show_notification(
                "Unable to load AIF workflow configuration. Please refresh the page or contact Support."
            );
        });

    // Preserve the existing AIF line options loading
    loadOptions(api_endpoints.aif_lines)
        .then(response => {
            if (response.ok) {
                return response.json();
            }
            return Promise.reject(response);
        })
        .then(data => {
            if ("actions" in data) {
                this.options["aif_line"] = data.actions.POST;
            }
        })
        .catch(error_response => {
            this.display_error(error_response);
        });
},

