from django.core.management.base import BaseCommand
from django.db import transaction

from sntracking.models import RegionMapping, EEAFlagChoices


class Command(BaseCommand):
    help = (
        "Insert missing country mappings and update clusters "
        "using exact country names."
    )

    REGION_MAPPING = {
        "Albania": ("AL", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Azerbaijan": ("AZ", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Bosnia and Herzegovina": ("BA", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Bulgaria": ("BG", EEAFlagChoices.EEA, "CCE"),
        "Croatia": ("HR", EEAFlagChoices.EEA, "CCE"),
        "Cyprus": ("CY", EEAFlagChoices.EEA, "CCE"),
        "Georgia": ("GE", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Greece": ("GR", EEAFlagChoices.EEA, "CCE"),
        "Israel": ("IL", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "The Former Yugoslav Republic of Macedonia": (
            "MK",
            EEAFlagChoices.OUTSIDE_EEA,
            "CCE",
        ),
        "Malta": ("MT", EEAFlagChoices.EEA, "CCE"),
        "Republic of Moldova": ("MD", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Montenegro": ("ME", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Romania": ("RO", EEAFlagChoices.EEA, "CCE"),
        "Serbia": ("RS", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Slovenia": ("SI", EEAFlagChoices.EEA, "CCE"),
        "Ukraine": ("UA", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Turkey": ("TR", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Armenia": ("AM", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Belarus": ("BY", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Kazakhstan": ("KZ", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Kyrgyzstan": ("KG", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Tajikistan": ("TJ", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Turkmenistan": ("TM", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Uzbekistan": ("UZ", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Kosovo": ("XK", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
        "Kaliningrad": ("RU", EEAFlagChoices.OUTSIDE_EEA, "CCE"),
    }

    def handle(self, *args, **options):
        inserted = 0
        updated = 0
        unchanged = 0

        self.stdout.write(
            self.style.NOTICE(
                f"Processing {len(self.REGION_MAPPING)} country mappings..."
            )
        )

        with transaction.atomic():
            for country, values in self.REGION_MAPPING.items():
                country_code, eea_flag, cluster = values

                # Match using the exact country name
                region = RegionMapping.objects.filter(
                    country=country
                ).first()

                if region is None:
                    # Insert a new record if the country does not exist
                    RegionMapping.objects.create(
                        country=country,
                        country_code=country_code,
                        eea_flag=eea_flag,
                        cluster=cluster,
                    )

                    inserted += 1
                    self.stdout.write(
                        self.style.SUCCESS(
                            f"Inserted: {country} -> {cluster}"
                        )
                    )
                    continue

                # Update cluster if it is NULL, blank, or different
                current_cluster = region.cluster

                if (
                    not current_cluster
                    or not current_cluster.strip()
                    or current_cluster != cluster
                ):
                    region.cluster = cluster
                    region.save(update_fields=["cluster"])

                    updated += 1
                    self.stdout.write(
                        self.style.SUCCESS(
                            f"Updated: {country} "
                            f"({current_cluster!r} -> {cluster})"
                        )
                    )
                else:
                    unchanged += 1
                    self.stdout.write(
                        f"Unchanged: {country} (cluster: {cluster})"
                    )

        # Display execution summary
        total = inserted + updated + unchanged

        self.stdout.write("")
        self.stdout.write(
            self.style.SUCCESS(
                "Region mapping update completed successfully."
            )
        )
        self.stdout.write(f"Total countries configured: {len(self.REGION_MAPPING)}")
        self.stdout.write(f"Inserted: {inserted}")
        self.stdout.write(f"Updated: {updated}")
        self.stdout.write(f"Unchanged: {unchanged}")
        self.stdout.write(f"Total processed: {total}")








