
async paste_lines_from_excel(line_items, index, event) {
    const clipboard = event.clipboardData;
    if (!clipboard) return;

    const text = clipboard.getData("text/plain");
    if (!text || !text.trim()) return;

    // Detect multi-column Excel data using tab characters.
    // Newlines alone are allowed in multiline text.
    const is_multi_cell = text.includes("\t");

    if (!is_multi_cell) {
        const target = event.target;

        // Allow normal paste into text fields and textareas.
        // This includes multiline paragraphs from Excel, Word, or Notepad.
        if (
            target.tagName === "TEXTAREA" ||
            (target.tagName === "INPUT" && target.type === "text")
        ) {
            return;
        }

        // Prevent single-value paste into dropdowns, date fields,
        // and other non-text controls.
        event.preventDefault();
        return;
    }

    // Existing multi-cell Excel paste logic starts here.
    this.loading = true;

    const disclosure_type = String(
        this.selected_predisclosure?.predisclosure_type ?? ""
    )
        .trim()
        .toUpperCase();

    if (!disclosure_type) {
        this.show_notification(
            "Please select a Disclosure Type before pasting Excel data."
        );
        this.loading = false;
        return;
    }

    event.preventDefault();

    const copied_lines = text
        .split(/\r?\n/)
        .filter(line => line.trim() !== "");

    if (!copied_lines.length) {
        this.loading = false;
        return;
    }

    const headers = copied_lines[0]
        .split("\t")
        .map(header => header.trim());

    if (!this.validate_paste_column_count(headers.length)) {
        this.show_notification(
            "Invalid Excel template. Please paste the proper template data as per disclosure type selection."
        );
        this.loading = false;
        return;
    }

    const field_mapping = [];

    for (
        let column_index = 0;
        column_index < headers.length;
        column_index++
    ) {
        const header = headers[column_index];

        const field = Object.keys(this.line_fields).find(
            field_name =>
                this.line_fields[field_name].label
                    .trim()
                    .toLowerCase() === header.toLowerCase()
        );

        if (!field) {
            continue;
        }

        field_mapping.push({ column_index, field });
    }

    if (!field_mapping.length) {
        this.show_notification(
            "No valid Pre-Disclosure columns were found in the pasted Excel data."
        );
        this.loading = false;
        return;
    }

    const current_line = line_items[index];

    const is_empty_temp_row =
        this.nav_context.context === "edit" &&
        current_line &&
        current_line.id === "temp";

    let pasted_row_count = 0;

    for (
        let row_index = 1;
        row_index < copied_lines.length;
        row_index++
    ) {
        const cells = copied_lines[row_index].split("\t");

        const row = {
            products: [],
            product_search: "",
            sda_partner_level: [],
            sda_partner_level_search: ""
        };

        if (this.nav_context.context === "edit") {
            row.id = "temp";
        }

        let has_value = false;
        let valid_row = true;

        for (const mapping of field_mapping) {
            let value = cells[mapping.column_index];

            if (value === undefined || value === null) {
                value = "";
            }

            value = String(value).trim();

            if (value) {
                has_value = true;
            }

            if (this.line_fields[mapping.field]?.date && value) {
                value = this.validate_pasted_date(value);

                if (!value) {
                    this.show_notification(
                        `${this.line_fields[mapping.field].label}: invalid date. Please enter a valid date.`
                    );
                    valid_row = false;
                    break;
                }
            }

            if (
                value &&
                !this.validate_pasted_value(mapping.field, value)
            ) {
                valid_row = false;
                break;
            }

            row[mapping.field] = value;
        }

        if (!has_value || !valid_row) {
            continue;
        }

        if (this.nav_context.context === "edit") {
            if (is_empty_temp_row && pasted_row_count === 0) {
                line_items[index] = row;
            } else {
                line_items.splice(index + pasted_row_count, 0, row);
                this.changes.new_lines_count++;
            }
        } else {
            if (pasted_row_count === 0) {
                line_items.splice(index, 1, row);
            } else {
                line_items.splice(index + pasted_row_count, 0, row);
            }
        }

        pasted_row_count++;
    }

    if (
        this.nav_context.context === "edit" &&
        is_empty_temp_row &&
        pasted_row_count > 0
    ) {
        this.changes.new_lines_count++;
    }

    if (pasted_row_count > 0) {
        this.show_notification(
            `${pasted_row_count} account(s) pasted successfully. Please select the Product(s) and SDA Partner Level(s) manually for each account.`
        );
    } else {
        this.show_notification(
            "No valid account rows were found in the pasted data."
        );
    }

    this.loading = false;
},






