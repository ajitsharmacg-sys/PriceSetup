<template #actions="actionProps">

    <tr
        v-if="get_ticket_level_actions(actionProps).length > 0"
    >
        <th>
            Actions
        </th>

        <td>

            <div class="btn-group">

                <button
                    v-for="action in get_ticket_level_actions(actionProps)"
                    :key="action.target_status"
                    type="button"
                    :class="action.class"
                    @click="open_ticket_level_action(action)"
                >
                    [[ action.label ]]
                </button>

                <button
                    v-if="actionProps?.ticket_status === 'DRAFT'"
                    type="button"
                    class="btn btn-sm btn-primary"
                    @click="navigate('price_setup_request', 'edit')"
                >
                    Edit
                </button>

            </div>

        </td>
    </tr>

</template>

-------------------
<!-- Generic Ticket Action Modal -->
<div
    v-if="show_ticket_action_modal"
    class="modal fade show"
    style="display: block;"
    tabindex="-1"
    aria-modal="true"
    role="dialog"
>
    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    [[ ticket_action.label ]]
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    :disabled="ticket_action_loading"
                    @click="close_ticket_action_modal()"
                ></button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Ticket Number
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        :value="selected_ticket?.ticket_number"
                        readonly
                    >

                </div>


                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Target Status
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        :value="ticket_action.target_status"
                        readonly
                    >

                </div>


                <div class="mb-3">

                    <label
                        for="ticket_action_comment"
                        class="form-label fw-semibold"
                    >
                        Comment
                    </label>

                    <textarea
                        id="ticket_action_comment"
                        class="form-control"
                        rows="4"
                        v-model="ticket_action.comment"
                        placeholder="Enter your comment"
                        :disabled="ticket_action_loading"
                    ></textarea>

                </div>


                <div class="mb-3">

                    <label
                        for="ticket_action_files"
                        class="form-label fw-semibold"
                    >
                        Attachments
                    </label>

                    <input
                        id="ticket_action_files"
                        type="file"
                        multiple
                        class="form-control"
                        accept="image/*,application/pdf,.xlsx,.xls,.doc,.docx"
                        @change="handle_ticket_action_files"
                        :disabled="ticket_action_loading"
                    >

                    <small class="form-text text-muted">
                        You can select multiple files.
                    </small>

                </div>


                <div
                    v-if="ticket_action.files?.length"
                    class="mb-3"
                >

                    <label class="form-label fw-semibold">
                        Selected Files
                    </label>

                    <ul class="list-group">

                        <li
                            v-for="file in ticket_action.files"
                            :key="file.name"
                            class="list-group-item d-flex justify-content-between align-items-center"
                        >
                            <span>
                                [[ file.name ]]
                            </span>

                            <small class="text-muted">
                                [[ Math.round(file.size / 1024) ]] KB
                            </small>
                        </li>

                    </ul>

                </div>

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    :disabled="ticket_action_loading"
                    @click="close_ticket_action_modal()"
                >
                    Cancel
                </button>

                <button
                    type="button"
                    class="btn btn-primary"
                    :disabled="ticket_action_loading"
                    @click="submit_ticket_action()"
                >

                    <span
                        v-if="ticket_action_loading"
                        class="spinner-border spinner-border-sm me-1"
                        role="status"
                    ></span>

                    <span v-if="!ticket_action_loading">
                        [[ ticket_action.label ]]
                    </span>

                    <span v-else>
                        Processing...
                    </span>

                </button>

            </div>

        </div>

    </div>
</div>

<!-- Generic modal backdrop -->
<div
    v-if="show_ticket_action_modal"
    class="modal-backdrop fade show"
></div>

