async submit_ticket_action() {

    if (!this.selected_ticket?.ticket_number) {
        this.show_notification("Ticket number is missing.");
        return;
    }

    if (!this.ticket_action?.target_status) {
        this.show_notification("Target status is missing.");
        return;
    }

    this.ticket_action_loading = true;

    try {

        const formData = new FormData();

        formData.append(
            "ticket_number",
            this.selected_ticket.ticket_number
        );

        formData.append(
            "status",
            this.ticket_action.target_status
        );

        formData.append(
            "comment",
            this.ticket_action.comment || ""
        );

        for (const file of this.ticket_action.files || []) {

            formData.append(
                "Upload_files",
                file
            );
        }

        const response = await fetch(
            this.api_endpoints.ticketstatus,
            {
                method: "POST",
                body: formData,
            }
        );

        if (!response.ok) {

            let error_message =
                "Unable to update ticket status.";

            try {
                const error_data = await response.json();
                error_message = error_data;
            } catch (e) {
                // Keep default message
            }

            throw new Error(
                typeof error_message === "string"
                    ? error_message
                    : JSON.stringify(error_message)
            );
        }

        await response.json();

        this.show_ticket_action_modal = false;

        this.ticket_action = {
            label: "",
            target_status: "",
            comment: "",
            files: [],
        };

        const fileInput =
            document.getElementById("ticket_action_files");

        if (fileInput) {
            fileInput.value = "";
        }

        await this.reload_ticket_status();

        this.update_triggered = !this.update_triggered;

        this.show_notification(
            "Ticket status updated successfully."
        );

    } catch (error) {

        this.show_notification(
            error?.message ||
            "Unable to update ticket status. Please try again."
        );

    } finally {

        this.ticket_action_loading = false;
    }
},

----------------

async reload_ticket_status() {

    try {

        const response = await fetch(
            this.api_endpoints.ticketstatus +
            "?ticket_number=" +
            this.selected_ticket?.ticket_number
        );

        if (!response.ok) {
            throw new Error("Unable to reload ticket status.");
        }

        const data = await response.json();

        this.selected_ticket.ticket_status = data;

    } catch (error) {

        this.show_notification(
            "Status updated, but the latest status could not be loaded."
        );
    }
},

