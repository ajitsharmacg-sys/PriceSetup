workflow: {},

ticket_action: {
    label: "",
    target_status: "",
    comment: "",
    files: [],
},

show_ticket_action_modal: false,
ticket_action_loading: false,


------------------

get_ticket_action(status) {
    const actions = {
        PENDING_SALESOPS_VALIDATION: {
            label: "Validate",
            class: "btn btn-primary btn-sm",
            type: "GENERIC",
        },

        PENDING_PM_VALIDATION: {
            label: "Validate",
            class: "btn btn-primary btn-sm",
            type: "GENERIC",
        },

        PENDING_ITCG_ANNOUNCEMENTS: {
            label: "Update DR",
            class: "btn btn-warning btn-sm",
            type: "UPDATE_DR",
        },

        PENDING_DRBG_ANNOUNCEMENTS: {
            label: "Update ER",
            class: "btn btn-warning btn-sm",
            type: "UPDATE_ER",
        },

        CLOSED: {
            label: "Close",
            class: "btn btn-success btn-sm",
            type: "GENERIC",
        },

        PM_REJECTED: {
            label: "Reject",
            class: "btn btn-danger btn-sm",
            type: "GENERIC",
        },

        SALESOPS_REJECTED: {
            label: "Reject",
            class: "btn btn-danger btn-sm",
            type: "GENERIC",
        },
    };

    return actions[status] || null;
},


----------------------

get_pending_setup_action(ticket) {

    if (
        ticket?.is_annoucement &&
        ticket?.announcement_choice === "ITCG"
    ) {
        return {
            label: "Update DR",
            class: "btn btn-warning btn-sm",
            type: "UPDATE_DR",
        };
    }

    if (
        ticket?.is_annoucement &&
        ticket?.announcement_choice === "ITCG_DRBG"
    ) {
        return {
            label: "Update ER",
            class: "btn btn-warning btn-sm",
            type: "UPDATE_ER",
        };
    }

    if (
        ticket?.is_annoucement &&
        ticket?.announcement_choice === "DRBG"
    ) {
        return {
            label: "Update ER",
            class: "btn btn-warning btn-sm",
            type: "UPDATE_ER",
        };
    }

    if (
        !ticket?.is_annoucement &&
        ticket?.announcement_choice === "NO_ANNOUNCEMENT"
    ) {
        return {
            label: "Update PM",
            class: "btn btn-warning btn-sm",
            type: "GENERIC",
        };
    }

    return null;
},

-----------------------

get_ticket_level_actions(ticket) {

    const available_statuses = this.get_ticket_status_choices();
    const actions = [];

    available_statuses.forEach(status => {

        if (status === "PENDING_SETUP") {

            const action = this.get_pending_setup_action(ticket);

            if (action) {
                actions.push({
                    ...action,
                    target_status: status,
                });
            }

            return;
        }

        const action = this.get_ticket_action(status);

        if (action) {
            actions.push({
                ...action,
                target_status: status,
            });
        }
    });

    return actions;
},


--------------

open_ticket_level_action(action) {

    if (!action) {
        return;
    }

    // DR has its own dedicated modal
    if (action.type === "UPDATE_DR") {
        this.show_modal("update_itcg");
        return;
    }

    // ER has its own dedicated modal
    if (action.type === "UPDATE_ER") {
        this.show_modal("update_drbg");
        return;
    }

    // Everything else uses the generic modal
    this.ticket_action = {
        label: action.label,
        target_status: action.target_status,
        comment: "",
        files: [],
    };

    this.show_ticket_action_modal = true;
},


-------------------

close_ticket_action_modal() {

    if (this.ticket_action_loading) {
        return;
    }

    this.show_ticket_action_modal = false;

    this.ticket_action = {
        label: "",
        target_status: "",
        comment: "",
        files: [],
    };

    const fileInput = document.getElementById("ticket_action_files");

    if (fileInput) {
        fileInput.value = "";
    }
},

-------------------

handle_ticket_action_files(event) {

    this.ticket_action.files = Array.from(
        event.target.files || []
    );
},

---------------

async submit_ticket_action() {

    if (!this.selected_ticket?.ticket_number) {
        this.show_notification("Ticket number is missing.");
        return;
    }

    if (!this.ticket_action?.target_status) {
        this.show_notification("Target status is missing.");
        return;
    }

    this.ticket_action_loading = true;

    try {

        const formData = new FormData();

        formData.append(
            "ticket_number",
            this.selected_ticket.ticket_number
        );

        formData.append(
            "status",
            this.ticket_action.target_status
        );

        formData.append(
            "comment",
            this.ticket_action.comment || ""
        );

        for (const file of this.ticket_action.files || []) {

            formData.append(
                "Upload_files",
                file
            );
        }

        const response = await fetch(
            this.api_endpoints.ticketstatus,
            {
                method: "POST",
                body: formData,
            }
        );

        if (!response.ok) {

            let error_message =
                "Unable to update ticket status.";

            try {
                const error_data = await response.json();
                error_message = error_data;
            } catch (e) {
                // Keep default message
            }

            throw new Error(
                typeof error_message === "string"
                    ? error_message
                    : JSON.stringify(error_message)
            );
        }

        await response.json();

        this.show_ticket_action_modal = false;

        this.ticket_action = {
            label: "",
            target_status: "",
            comment: "",
            files: [],
        };

        const fileInput =
            document.getElementById("ticket_action_files");

        if (fileInput) {
            fileInput.value = "";
        }

        await this.reload_ticket_status();

        this.update_triggered = !this.update_triggered;

        this.show_notification(
            "Ticket status updated successfully."
        );

    } catch (error) {

        this.show_notification(
            error?.message ||
            "Unable to update ticket status. Please try again."
        );

    } finally {

        this.ticket_action_loading = false;
    }
},

----------------

async reload_ticket_status() {

    try {

        const response = await fetch(
            this.api_endpoints.ticketstatus +
            "?ticket_number=" +
            this.selected_ticket?.ticket_number
        );

        if (!response.ok) {
            throw new Error("Unable to reload ticket status.");
        }

        const data = await response.json();

        this.selected_ticket.ticket_status = data;

    } catch (error) {

        this.show_notification(
            "Status updated, but the latest status could not be loaded."
        );
    }
},

