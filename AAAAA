<!-- Generic Ticket Action Modal -->
<section class="modal fade" id="ticket_action_modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    [[ ticket_action.title ]]

                    <span
                        class="spinner-border text-primary ms-2"
                        :style="ticket_action.loading
                            ? 'display: inline-block;'
                            : 'display: none;'">
                    </span>
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    @click="close_ticket_action_modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <p>
                        Ticket Number:
                        <strong>[[ selected_ticket?.ticket_number ]]</strong>
                    </p>
                </div>

                <div class="row mb-3">

                    <label
                        class="col-sm-2 col-form-label"
                        for="ticket_action_comment">
                        Comment
                    </label>

                    <div class="col-sm-10">

                        <textarea
                            id="ticket_action_comment"
                            class="form-control"
                            rows="5"
                            v-model="ticket_action.comment">
                        </textarea>

                    </div>

                </div>

                <div class="row mb-3">

                    <label
                        class="col-sm-2 col-form-label"
                        for="ticket_action_file">
                        File Upload
                    </label>

                    <div class="col-sm-10">

                        <input
                            type="file"
                            multiple
                            class="form-control"
                            accept="image/*,application/pdf,.xlsx,.xls"
                            id="ticket_action_file">

                        <small class="form-text text-muted">
                            File will be uploaded to
                            <a
                                :href="selected_ticket?.link"
                                target="_blank">
                                SharePoint
                            </a>
                        </small>

                    </div>

                </div>

                <div class="text-center">

                    <button
                        type="button"
                        class="btn btn-primary me-2"
                        :disabled="ticket_action.loading"
                        @click="submit_ticket_action">

                        [[ ticket_action.submit_label ]]

                    </button>

                    <button
                        v-if="ticket_action.show_reject"
                        type="button"
                        class="btn btn-danger"
                        :disabled="ticket_action.loading"
                        @click="submit_ticket_rejection">

                        Reject

                    </button>

                </div>

            </div>
        </div>
    </div>
</section>


ticket_action: {
    title: "",
    submit_label: "",
    status: "",
    navigation: "",
    context: "",
    comment: "",
    loading: false,
    show_reject: false,
},


<div class="text-center">
    <div class="d-flex justify-content-center flex-wrap gap-2">

        <button
            v-for="action in get_ticket_level_actions(selected_ticket)"
            :key="action.status"
            type="button"
            :class="action.button_class"
            @click="open_ticket_action_modal(action)">
            [[ action.label ]]
        </button>

        <button
            v-if="get_ticket_status(selected_ticket) === 'DRAFT'"
            type="button"
            class="btn btn-primary btn-sm"
            @click="navigate('price_setup_request', 'edit')">
            Edit
        </button>

    </div>
</div>


get_ticket_level_actions(ticket) {

    const current_status = this.get_ticket_status(ticket);

    if (!current_status || !this.workflow?.TICKET_STATUS_GRAPH) {
        return [];
    }

    const next_statuses =
        this.workflow.TICKET_STATUS_GRAPH[current_status] || [];

    const user_roles = Array.isArray(this.user_role)
        ? this.user_role
        : [this.user_role];

    const actions = [];

    next_statuses.forEach(status => {

        const allowed_roles =
            this.workflow.TICKET_STATUS_TO_ROLE?.[status] || [];

        const role_allowed =
            allowed_roles.includes(this.workflow.ADMIN_ROLE) ||
            allowed_roles.some(role => user_roles.includes(role));

        if (!role_allowed) {
            return;
        }

        // PENDING_SETUP has different actions
        // depending on announcement configuration.
        if (status === "PENDING_SETUP") {

            const action = this.get_pending_setup_action(ticket);

            if (action) {
                actions.push({
                    ...action,
                    status: status,
                });
            }

            return;
        }

        const action = this.get_ticket_action(status);

        if (action) {
            actions.push({
                ...action,
                status: status,
            });
        }
    });

    return actions;
},

get_ticket_action(status) {

    const actions = {

        PENDING_SALESOPS_VALIDATION: {
            label: "Validate",
            title: "Validate Price Setup Request",
            submit_label: "Approve",
            button_class: "btn btn-primary btn-sm",
            show_reject: true,
        },

        PENDING_PM_VALIDATION: {
            label: "Validate",
            title: "Validate Price Setup Request",
            submit_label: "Approve",
            button_class: "btn btn-primary btn-sm",
            show_reject: true,
        },

        PENDING_ITCG_ANNOUNCEMENTS: {
            label: "Update DR",
            title: "Update DR Announcement",
            submit_label: "Submit",
            button_class: "btn btn-warning btn-sm",
            show_reject: false,
        },

        PENDING_DRBG_ANNOUNCEMENTS: {
            label: "Update ER",
            title: "Update ER Announcement",
            submit_label: "Submit",
            button_class: "btn btn-warning btn-sm",
            show_reject: false,
        },

        CLOSED: {
            label: "Close",
            title: "Close Price Setup Request",
            submit_label: "Confirm",
            button_class: "btn btn-success btn-sm",
            show_reject: false,
        },

        SALESOPS_REJECTED: {
            label: "Reject",
            title: "Reject Price Setup Request",
            submit_label: "Reject",
            button_class: "btn btn-danger btn-sm",
            show_reject: false,
        },

        PM_REJECTED: {
            label: "Reject",
            title: "Reject Price Setup Request",
            submit_label: "Reject",
            button_class: "btn btn-danger btn-sm",
            show_reject: false,
        },

    };

    return actions[status] || null;
},

get_pending_setup_action(ticket) {

    if (
        ticket?.is_annoucement &&
        ticket?.announcement_choice === "ITCG"
    ) {
        return {
            label: "Update DR",
            title: "Update DR",
            submit_label: "Submit",
            button_class: "btn btn-warning btn-sm",
            show_reject: false,
        };
    }

    if (
        ticket?.is_annoucement &&
        ticket?.announcement_choice === "ITCG_DRBG"
    ) {
        return {
            label: "Update ER",
            title: "Update ER",
            submit_label: "Submit",
            button_class: "btn btn-warning btn-sm",
            show_reject: false,
        };
    }

    if (
        ticket?.is_annoucement &&
        ticket?.announcement_choice === "DRBG"
    ) {
        return {
            label: "Update ER",
            title: "Update ER",
            submit_label: "Submit",
            button_class: "btn btn-warning btn-sm",
            show_reject: false,
        };
    }

    if (
        !ticket?.is_annoucement &&
        ticket?.announcement_choice === "NO_ANNOUNCEMENT"
    ) {
        return {
            label: "Update PM",
            title: "Send PM for Validation",
            submit_label: "Confirm",
            button_class: "btn btn-warning btn-sm",
            show_reject: false,
        };
    }

    return null;
},


open_ticket_action_modal(action) {

    this.ticket_action = {
        title: action.title,
        submit_label: action.submit_label,
        status: action.status,
        navigation: action.navigation || "",
        context: action.context || "",
        comment: "",
        loading: false,
        show_reject: action.show_reject || false,
    };

    const modal_element =
        document.getElementById("ticket_action_modal");

    const modal = bootstrap.Modal.getOrCreateInstance(
        modal_element
    );

    modal.show();
},

async submit_ticket_action() {

    await this.submit_ticket_status(
        this.ticket_action.status
    );
},

async submit_ticket_rejection() {

    let rejection_status = null;

    const current_status =
        this.get_ticket_status(this.selected_ticket);

    if (current_status === "PENDING_SALESOPS_VALIDATION") {
        rejection_status = "SALESOPS_REJECTED";
    }

    if (current_status === "PENDING_PM_VALIDATION") {
        rejection_status = "PM_REJECTED";
    }

    if (!rejection_status) {
        this.display_error(
            null,
            "Rejection is not available for the current ticket status."
        );
        return;
    }

    await this.submit_ticket_status(rejection_status);
},


async submit_ticket_status(status) {

    this.ticket_action.loading = true;

    const formData = new FormData();

    formData.append(
        "ticket_number",
        this.selected_ticket.ticket_number
    );

    formData.append(
        "comment",
        this.ticket_action.comment || ""
    );

    formData.append(
        "status",
        status
    );

    const file_field =
        document.getElementById("ticket_action_file");

    if (file_field?.files) {

        for (let i = 0; i < file_field.files.length; i++) {
            formData.append(
                "Upload_files",
                file_field.files[i]
            );
        }
    }

    try {

        await this.upload_ticket_files();

        const response =
            await postFormData(
                this.api_endpoints.ticketstatus,
                formData
            );

        if (!response.ok) {
            throw response;
        }

        await response.json();

        this.close_ticket_action_modal();

        this.reset_ticket_action();

        await this.reload_ticket_status(
            this.selected_ticket.ticket_number
        );

        this.dialog
            .reset_to_default()
            .set_title("Success")
            .set_message(
                this.get_ticket_success_message(status)
            )
            .set_true_action("Close")
            .show();

    } catch (error) {

        this.display_error(
            error,
            "The Price Setup Request action could not be completed. Please try again or contact support."
        );

    } finally {

        this.ticket_action.loading = false;
    }
},



async upload_ticket_files() {

    const file_field =
        document.getElementById("ticket_action_file");

    if (!file_field?.files?.length) {
        return;
    }

    const base_url =
        "{{ site_address|escapejs }}{{ library|escapejs }}";

    const path =
        this.selected_ticket.link.substring(
            base_url.length + 1
        );

    const upload_url =
        "{{ sharepoint_upload_endpoint|escapejs }}";

    for (const file of file_field.files) {

        if (!file?.name) {
            continue;
        }

        const response = await fetch(
            upload_url,
            {
                method: "POST",
                body: file,
                headers: {
                    "site_address":
                        "{{ site_address|escapejs }}",

                    "library":
                        "{{ library|escapejs }}",

                    "path": path,

                    "filename": file.name,
                }
            }
        );

        if (!response.ok) {
            throw response;
        }
    }
},


