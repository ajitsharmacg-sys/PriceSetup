from django import forms

class PreDisclosureSDALevelAdminForm(forms.ModelForm):
    class Meta:
        model = PreDisclosureSDALevel
        fields = "__all__"

    def clean_name(self):
        name = self.cleaned_data["name"].strip()

        queryset = PreDisclosureSDALevel.objects.filter(
            name__iexact=name
        )

        if self.instance.pk:
            queryset = queryset.exclude(pk=self.instance.pk)

        if queryset.exists():
            raise forms.ValidationError(
                "This SDA Level already exists."
            )

        return name




