                            </div>

                        </li>

                    </template>

                </ul>

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    @click="hide_modal('line_status_modal')"
                >
                    Close
                </button>

            </div>

        </div>

    </div>

</div>












