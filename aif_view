async update_aif_status() {

    this.show_aif_status_update = false;

    this.show_notification(
        "Updating AIF status, please wait..."
    );

    await postData(
        this.endpoints.aif_status,
        {
            aif: this.selected_aif.aif_id,
            status: this.aif_target_status,
            comment: this.comment
        }
    )
    .then(response => {

        if (response.ok) {
            return response.json();
        }

        return Promise.reject(response);

    })
    .then(() => {

        this.upload_file(
            "aif_status_update_attachment",
            "_status_update_"
        );

        this.show_notification(
            "AIF status has been updated."
        );

        this.update_triggered = true;

        this.comment = null;
        this.aif_target_status = null;

    })
    .catch(error_response => {

        this.display_error(error_response);

    });
},




async update_line_status() {

    this.show_line_status_update = false;

    let error_occurred = false;

    for (const line of this.selected_lines) {

        this.show_notification(
            "Updating status of line: " + line.id
        );

        await postData(
            this.endpoints.aif_line_status,
            {
                aif_line: line.id,
                status: this.line_target_status,
                comment: this.comment
            }
        )
        .then(response => {

            if (response.ok) {
                return response.json();
            }

            return Promise.reject(response);

        })
        .catch(error => {

            error_occurred = true;

            this.display_error(error);

        });

        if (error_occurred) {
            break;
        }
    }

    if (!error_occurred) {

        await this.upload_file(
            "aif_line_status_update_attachment"
        );

        this.update_triggered = true;

        this.selected_lines = [];

        this.comment = null;

        this.line_target_status = null;

        this.show_notification(
            "Selected AIF line(s) updated successfully."
        );
    }
},



aif_line: line.id


navigate(id, context = null) {
    this.nav_context.context = context;
    this.current_screen = id;
},

