                <ul class="list-group">

                    <template
                        v-for="status in selected_line?.aif_line_status"
                    >

                        <li class="list-group-item">

                            <div class="text-body-secondary">

                                <span
                                    :class="status_format(status.status)"
                                >
                                    [[ format_status_label(status.status) ]]
                                </span>

                                by

                                <span class="fw-medium">
                                    [[ status.meta_created_by?.first_name ]]
                                    [[ status.meta_created_by?.last_name ]]
