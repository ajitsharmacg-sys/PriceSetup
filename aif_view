<!-- ===================== HEADER ===================== -->
<div class="row g-4">

    <!-- ================= LEFT SIDE ================= -->
    <div class="col-12 col-lg-6">

        <!-- Customer Details -->
        <div class="p-1">

            <django-paged-table
                :api_endpoint="api_endpoints.aif_customer_line"
                :columns="customer_columns"
                :fixed_query_filter="customer_filter"
                title="Customer Details"
                :custom_format="custom_format"
                v-model:data_refresh_trigger="update_triggered">
            </django-paged-table>

        </div>

        <!-- AIF Status History -->
        <div class="p-1 mt-3">

            <status-history
                :api_endpoint="aif_status_history_url"
                v-model:data_refresh_trigger="update_triggered"
                :custom_format="custom_format?.aif_status">
            </status-history>

        </div>

    </div>


    <!-- ================= RIGHT SIDE ================= -->
    <div class="col-12 col-lg-6">

        <div class="p-1">

            <vertical-table
                :api_endpoint="get_url"
                :columns="header_columns"
                v-model:data_refresh_trigger="update_triggered"
                :custom_format="custom_format"
                @on-item-update="(item) => { this.selected_aif = item; }">

                <!-- AIF Actions -->
                <template #actions="actionProps">

                    <!-- AIF Level Actions -->
                    <tr v-if="actionProps?.aif_status !== 'CLOSED'
                        && actionProps?.aif_status !== 'PLANNED'">

                        <th>AIF Level Actions</th>

                        <td>
                            <div class="btn-group">

                                <template
                                    v-for="choice in get_status_choices()"
                                >

                                    <button
                                        type="button"
                                        :class="get_display_action(choice).button_class"
                                        @click="show_modal('modal_' + choice)"
                                    >
                                        [[ get_display_action(choice).button_text ]]
                                    </button>

                                </template>

                                <button
                                    v-if="['DRAFT', 'INVALID'].includes(actionProps?.aif_status)"
                                    type="button"
                                    class="btn btn-sm btn-primary"
                                    @click="navigate('aif_app', 'edit')"
                                >
                                    Edit
                                </button>

                            </div>
                        </td>

                    </tr>


                    <!-- Line Level Actions -->
                    <tr v-if="actionProps?.aif_status === 'PLANNED'">

                        <th>Line Level Actions</th>

                        <td>

                            <div
                                v-if="checked_lines.length > 0"
                                class="btn-group"
                            >

                                <template
                                    v-for="choice in multiple_line_status_choices()"
                                >

                                    <button
                                        type="button"
                                        :class="get_line_display_action(choice).button_class"
                                        @click="show_modal('line_modal_' + choice)"
                                    >
                                        [[ get_line_display_action(choice).button_text ]]
                                    </button>

                                </template>

                            </div>

                            <div
                                v-else
                                class="py-2"
                            >
                                <span class="text-muted small">
                                    Select line to see available action.
                                </span>
                            </div>

                        </td>

                    </tr>

                </template>

            </vertical-table>

        </div>

    </div>

</div>


<!-- ===================== AIF LINES ===================== -->
<div class="container-fluid mt-5">

    <django-paged-table
        :api_endpoint="api_endpoints.aif_lines"
        :columns="line_columns"
        :fixed_query_filter="line_filter"
        title="AIF Lines"
        :filter_items="line_filter_items"
        :row_select_active="true"
        v-model:data_refresh_trigger="update_triggered"
        :custom_format="custom_format"

        @row-select="(item, index) => {
            if (canActOnLine(item)) {
                checked_lines.push(item);
            }
        }"

        @row-unselect="(item, index) => {
            const indexToRemove = checked_lines.indexOf(item);
            if (indexToRemove !== -1) {
                checked_lines.splice(indexToRemove, 1);
            }
        }"
    >

        <!-- Line Actions -->
        <template #actions="actionProps">

            <div class="btn-group">

                <button
                    type="button"
                    class="btn btn-secondary"
