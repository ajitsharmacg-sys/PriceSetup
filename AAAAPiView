DECLARE @CurrentAIFID INT = 10080;
DECLARE @NSO NVARCHAR(50) = 'UK';

SELECT
    a.aif_id,
    a.start_date,
    a.end_date,
    l.mercury_code,
    l.promotional_elp,
    c.oracle_cust_number AS customer,
    (
        SELECT TOP 1 s.status
        FROM aif_aifstatus s
        WHERE s.aif_id = a.aif_id
        ORDER BY s.id DESC
    ) AS latest_status
FROM aif_aif a
INNER JOIN aif_aiflines l
    ON l.aif_id = a.aif_id
INNER JOIN aif_aiflines current_l
    ON current_l.aif_id = @CurrentAIFID
    AND current_l.mercury_code = l.mercury_code
INNER JOIN aif_aifcustomerlines c
    ON c.aif_id = a.aif_id
INNER JOIN aif_aifcustomerlines current_c
    ON current_c.aif_id = @CurrentAIFID
    AND current_c.oracle_cust_number = c.oracle_cust_number
WHERE
    a.aif_id <> @CurrentAIFID
    AND a.nso = @NSO
    AND (
        SELECT TOP 1 s.status
        FROM aif_aifstatus s
        WHERE s.aif_id = a.aif_id
        ORDER BY s.id DESC
    ) IN ('DRAFT', 'PLANNED', 'INVALID');


