# --------------------------------------------------
# Ticket Line Serializers
# --------------------------------------------------

class TicketLineReadSerializer(serializers.ModelSerializer):
    meta_created_by = serializers.StringRelatedField(
        many=False,
        read_only=True,
        label="Created By",
    )
    meta_edited_by = serializers.StringRelatedField(
        many=False,
        read_only=True,
        label="Last Edited By",
    )

    class Meta:
        model = TicketLine
        fields = "__all__"
        read_only_fields = [
            "meta_created_date",
            "meta_created_by",
            "meta_edited_date",
            "meta_edited_by",
        ]


class TicketLineWriteSerializer(serializers.ModelSerializer):
    class Meta:
        model = TicketLine
        fields = "__all__"
        read_only_fields = [
            "meta_created_date",
            "meta_created_by",
            "meta_edited_date",
            "meta_edited_by",
        ]


