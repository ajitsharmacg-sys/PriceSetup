add_line() {
    const new_line = {
        country: "",
        products: [],
        product_search: "",
        sda_partner_level: [],
        sda_partner_level_search: "",
    };

    if (this.is_edit_mode) {
        new_line.id = "temp";
        this.changes.new_lines_count++;
    }

    this.lines.push(new_line);
},


handle_change(event) {
    const field = event.target.name;

    switch (field) {
        case "cluster":
            this.lines.forEach((line, index) => {
                if (!this.available_countries.includes(line.country)) {
                    line.country = "";
                    this.handle_line_change(index);
                }
            });
            break;

        case "product_category":
            this.load_products();
            break;

        case "predisclosure_type":
            this.resetDisclosureFields();

            if (event.target.value === "PARTNER") {
                this.load_sda_partner_levels();
            } else {
                this.sda_partner_levels = [];
            }
            break;
    }
},






async load_country_clusters() {
    this.loading = true;
    this.country_cluster_data = [];

    await fetch(api_endpoints.country_clusters)
        .then(response => {
            if (response.ok) {
                return response.json();
            }
            return Promise.reject(response);
        })
        .then(data => {
            this.country_cluster_data = data.results ?? data;
            this.loading = false;
        })
        .catch(error => {
            this.loading = false;
            this.display_error(error);
        });
},

