from rest_framework import serializers
from sntracking.models import RegionMapping


class CountryClusterSerializer(serializers.ModelSerializer):
    class Meta:
        model = RegionMapping
        fields = ("cluster", "country")


class CountryClusterView(viewsets.ReadOnlyModelViewSet):
    permission_classes = [IsApplicationUser]
    serializer_class = CountryClusterSerializer

    def get_queryset(self):
        queryset = RegionMapping.objects.all()

        cluster = self.request.query_params.get("cluster")

        if cluster:
            queryset = queryset.filter(cluster__iexact=cluster)

        return queryset.order_by("cluster", "country").distinct()


