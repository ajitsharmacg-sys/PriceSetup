data() {
    return {
        selected_cluster: null,
        countries: [],
        loading_countries: false,
    };
},

methods: {
    async load_countries_by_cluster(cluster) {
        this.selected_cluster = cluster;
        this.countries = [];

        if (!cluster) {
            return;
        }

        this.loading_countries = true;

        try {
            const response = await fetch(
                `/api/country-clusters/?cluster=${encodeURIComponent(cluster)}`
            );

            if (!response.ok) {
                throw new Error("Failed to load countries");
            }

            const data = await response.json();

            this.countries = data.results
                ? data.results.map(item => item.country)
                : data.map(item => item.country);

        } catch (error) {
            console.error("Error loading countries:", error);
            this.countries = [];
        } finally {
            this.loading_countries = false;
        }
    },
},


