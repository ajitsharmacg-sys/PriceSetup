from django.contrib import admin

from predisclosure.models import (
    PreDisclosure,
    PreDisclosureStatus,
    PreDisclosureLine,
    PreDisclosureLineStatus,
)


@admin.register(PreDisclosure)
class PreDisclosureAdmin(admin.ModelAdmin):
    list_display = (
        "predisclosure_id",
        "region",
        "predisclosure_type",
        "product_category",
        "meta_created_date",
        "meta_created_by",
    )
    list_filter = (
        "region",
        "predisclosure_type",
        "product_category",
    )
    search_fields = (
        "predisclosure_id",
        "region",
    )


@admin.register(PreDisclosureStatus)
class PreDisclosureStatusAdmin(admin.ModelAdmin):
    list_display = (
        "id",
        "predisclosure",
        "status",
        "meta_created_date",
        "meta_created_by",
    )
    list_filter = ("status",)
    search_fields = (
        "predisclosure__predisclosure_id",
        "status",
    )


@admin.register(PreDisclosureLine)
class PreDisclosureLineAdmin(admin.ModelAdmin):
    list_display = (
        "id",
        "predisclosure",
        "account_name",
        "website",
        "meeting_date",
    )
    search_fields = (
        "predisclosure__predisclosure_id",
        "account_name",
        "website",
    )
    list_filter = (
        "disclosed_last_2_years",
        "nda_confirmed",
        "disclosure_format",
    )


@admin.register(PreDisclosureLineStatus)
class PreDisclosureLineStatusAdmin(admin.ModelAdmin):
    list_display = (
        "id",
        "line",
        "status",
        "meta_created_date",
        "meta_created_by",
    )
    list_filter = ("status",)
    search_fields = (
        "line__predisclosure__predisclosure_id",
        "line__account_name",
        "status",
    )
