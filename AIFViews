export const DecimalCell = {
    delimiters: ['[[', ']]'],
    props: {
        value: {
            type: [String, Number],
            default: ""
        }
    },
    methods: {
        numberWithCommas(x) {
            if (x === null || x === undefined || x === "") {
                return "";
            }

            return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }
    },
    template: `
    <td :title="value">
        <span class="app-cell-clamp">[[ numberWithCommas(value) ]]</span>
    </td>
    `
}

