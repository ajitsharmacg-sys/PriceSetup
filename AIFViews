async update_line_status() {
    this.show_line_status_update = false;
    this.refreshing = true;

    let error_occured = false;

    for (const line of this.selected_lines) {

        await postData(api_endpoints.aif_line_status, {
            aif_line: line.id,
            status: this.line_target_status,
            comment: this.comment
        })
        .then(response => {
            if (response.ok) {
                return response.json();
            }

            return Promise.reject(response);
        })
        .catch(error_response => {

            error_occured = true;

            error_response.json().then(data => {

                const message = data?.detail
                    ? data.detail
                    : "An error occurred during the update of the status for line: " + line.id;

                this.display_error(error_response, message);
            });
        });
    }

    if (!error_occured) {

        await this.upload_file("line_status_update_attachment");

        this.update_triggered = true;

        this.selected_lines = [];

        this.comment = null;

        this.line_target_status = null;
    }

    this.refreshing = false;
},





