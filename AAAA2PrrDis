                return response.json();
            }
            return Promise.reject(response);
        })
        .then(data => {
            this.selected_aif.aif_customer_lines = Array.isArray(data)
                ? data
                : (data.results || []);
        })
        .catch(error_response => {
            this.display_error(error_response);
        });

    await this.$nextTick();

    this.is_loading_aif = false;

    console.log("Load AIF End");
