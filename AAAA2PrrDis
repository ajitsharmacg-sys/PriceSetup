async getPromoValues(aifId) {
    let values = {
        promo_value: "0.00",
        promo_value_eur: "0.00",
    };

    await fetch(this.endpoints.aif + aifId + "/promo-values/")
        .then(response => {
            if (!response.ok) return Promise.reject(response);
            return response.json();
        })
        .then(data => {
            values = {
                promo_value: Number(data.promo_value || 0).toFixed(2),
                promo_value_eur: Number(data.promo_value_eur || 0).toFixed(2),
            };
        })
        .catch(error_response => {
            this.display_error(error_response);
        });

    return values;
},




from django.db.models import Sum
from rest_framework.decorators import action
from rest_framework.response import Response

class AifView(viewsets.ModelViewSet):

    # Keep your existing configuration and methods

    @action(detail=True, methods=["get"], url_path="promo-values")
    def promo_values(self, request, pk=None):
        aif = self.get_object()

        totals = AifLines.objects.filter(aif=aif).aggregate(
            promo_value=Sum("line_value"),
            promo_value_eur=Sum("line_value_eur"),
        )

        return Response({
            "aif_id": aif.aif_id,
            "promo_value": totals["promo_value"] or 0,
            "promo_value_eur": totals["promo_value_eur"] or 0,
        })

