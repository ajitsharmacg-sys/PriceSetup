async getPromoValues(aifId) {
    let values = {
        promo_value: "0.00",
        promo_value_eur: "0.00",
    };

    await fetch(this.endpoints.aif + aifId + "/promo-values/")
        .then(response => {
            if (!response.ok) return Promise.reject(response);
            return response.json();
        })
        .then(data => {
            values = {
                promo_value: Number(data.promo_value || 0).toFixed(2),
                promo_value_eur: Number(data.promo_value_eur || 0).toFixed(2),
            };
        })
        .catch(error_response => {
            this.display_error(error_response);
        });

    return values;
},




