methods: {
    async loadOrganizations(cluster) {
        this.availableOrganizations = [];

        if (!cluster) {
            return;
        }

        try {
            const response = await fetch(
                `${this.endpoints.predisclosure}organizations/?cluster=${encodeURIComponent(cluster)}`
            );

            if (!response.ok) {
                throw response;
            }

            const data = await response.json();
            this.availableOrganizations = data.results || [];
        } catch (error) {
            this.display_error(error);
        }
    },

    async onRegionChange(cluster) {
        this.selectedRegion = cluster;
        await this.loadOrganizations(cluster);

        // Clear existing account country selections if they
        // don't belong to the newly selected region.
        // Adapt this loop to your existing account data structure.
        this.accounts.forEach(account => {
            const valid = this.availableOrganizations.some(
                org => org.id === account.organization
            );

            if (!valid) {
                account.organization = "";
            }
        });
    },
},


