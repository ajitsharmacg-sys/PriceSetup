    this.is_loading_aif = true;

    await fetch(this.endpoints.aif_lines + "?aif=" + this.aif_id)
        .then(response => {
            if (response.ok) {
                return response.json();
            }
            return Promise.reject(response);
        })
        .then(data => {
            this.selected_aif.aif_lines = Array.isArray(data)
                ? data
                : (data.results || []);
        })
        .catch(error_response => {
            this.display_error(error_response);
        });

    await fetch(
        this.endpoints.aif_customer_line + "?aif=" + this.aif_id
    )
