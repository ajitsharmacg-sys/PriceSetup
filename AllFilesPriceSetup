class StandardPagination(PageNumberPagination):
    page_size = 8
    page_size_query_param = "page_size"
    max_page_size = 25


def get_ticket_status(ticket_id):
    """Return the most recently created status history row for a ticket."""
    return TicketStatus.objects.filter(ticket_number_id=ticket_id).order_by("-id").first()


class TicketView(viewsets.ModelViewSet):
    permission_classes = [IsApplicationUser]
    queryset = Ticket.objects.all()
    pagination_class = StandardPagination
    filter_backends = [DjangoFilterBackend, filters.SearchFilter, filters.OrderingFilter, TicketByStatusFilter]
    filterset_fields = {
        "id": ["exact"],
        "ticket_number": ["exact"],
        "meta_created_date": ["exact", "gt", "lt", "gte", "lte"],
        "meta_edited_date": ["exact", "gt", "lt", "gte", "lte"],
        "start_date": ["exact", "gt", "lt", "gte", "lte"],
        "end_date": ["exact", "gt", "lt", "gte", "lte"],
    }
    search_fields = ["ticket_number", "subject"]
    ordering_fields = ["ticket_number", "meta_created_date", "meta_edited_date", "start_date", "end_date"]
    ordering = ["ticket_number"]

    def get_serializer_class(self):
        if self.action in ("create", "update", "partial_update"):
            return TicketWriteSerializer
        return TicketReadSerializer

    def perform_create(self, serializer):
        email_list = self.request.data.get("email_cc")
        ticket = serializer.save(meta_created_by=self.request.user, email_cc=email_list)
        TicketStatus.objects.create(
            ticket_number=ticket,
            status=TicketStatusChoices.DRAFT,
            meta_created_by=self.request.user,
        )

    def perform_update(self, serializer):
        ticket_id = self.get_object().pk
        current_status = get_ticket_status(ticket_id)
        editable_statuses = {
            TicketStatusChoices.DRAFT,
            TicketStatusChoices.PM_REJECTED,
            TicketStatusChoices.SALESOPS_REJECTED,
        }
        if not current_status or current_status.status not in editable_statuses:
            raise PermissionDenied("You can't edit this Price Setup Request!")
        serializer.save(
            meta_edited_by=self.request.user,
            meta_edited_date=timezone.now(),
            email_cc=self.request.data.get("email_cc"),
        )

    def perform_destroy(self, instance):
        current_status = get_ticket_status(instance.pk)
        deletable_statuses = {
            TicketStatusChoices.DRAFT,
            TicketStatusChoices.PM_REJECTED,
            TicketStatusChoices.SALESOPS_REJECTED,
        }
        is_admin = self.request.user.groups.filter(name=ADMIN_ROLE).exists()
        if (current_status and current_status.status in deletable_statuses) or is_admin:
            return super().perform_destroy(instance)
        raise PermissionDenied(f"Only {ADMIN_ROLE} can delete this request.")


