class TicketStatusView(viewsets.ModelViewSet):
    permission_classes = [IsApplicationUser]
    parser_classes = [MultiPartParser, FormParser, JSONParser]
    queryset = TicketStatus.objects.all()
    serializer_class = TicketStatusSerializer
    filter_backends = [DjangoFilterBackend, filters.SearchFilter, filters.OrderingFilter]
    filterset_fields = {
        "ticket_number": ["exact"],
        "meta_created_date": ["exact", "gt", "lt", "gte", "lte"],
    }
    search_fields = ["status"]
    ordering_fields = ["meta_created_date"]
    ordering = ["meta_created_date"]

    def create(self, request, *args, **kwargs):
        # Multipart requests carry status and ticket_number in request.POST; JSON requests use request.data.
        response = super().create(request, *args, **kwargs)
        return response

    def perform_create(self, serializer):
        files = self.request.FILES.getlist("Upload_files")
        data = self.request.data
        comments = data.get("comment")
        target_status = data.get("status")
        ticket_number = data.get("ticket_number")
        if comments in ("", None, "null"):
            comments = None
        if not target_status or not ticket_number:
            raise ValidationError({"detail": "Both ticket_number and status are required."})

        try:
            ticket = Ticket.objects.get(ticket_number=ticket_number)
        except Ticket.DoesNotExist:
            raise ValidationError({"ticket_number": "Ticket not found."})

        current_status_record = get_ticket_status(ticket.pk)
        if not current_status_record:
            raise ValidationError({"status": "No initial status exists for this ticket."})
        current_status = current_status_record.status

        if not is_valid_ticket_transition(current_status, target_status):
            raise ValidationError({"status": f"Invalid status transition from {current_status} to {target_status}."})

        user_roles = get_user_roles(self.request.user)
        if not is_role_allowed_for_ticket_status(user_roles, target_status):
            raise PermissionDenied(f"Your role is not allowed to set status {target_status}.")

        # Save the intermediate history records configured in workflow.py first.
        for intermediate_status in get_intermediate_statuses(ticket, target_status):
            TicketStatus.objects.create(
                ticket_number=ticket,
                status=intermediate_status,
                comments=comments,
                meta_created_by=self.request.user,
            )

        instance = serializer.save(
            ticket_number=ticket,
            status=target_status,
            comments=comments,
            meta_created_by=self.request.user,
        )

        attachments = self.process_files(files)
        handle_announcement_emails(self.request, ticket, target_status, attachments)
        handle_pm_or_salesops_emails(
            self.request, ticket, instance, target_status, comments, attachments
        )

    @staticmethod
    def process_files(files):
        attachment_list = []
        for file_obj in files:
            encoded = base64.b64encode(file_obj.read()).decode("utf-8")
            attachment_list.append({"Name": file_obj.name, "ContentBytes": encoded})
        return attachment_list


