def send_workflow_notification(
    status,
    request,
    ticket,
    comments=None,
    attachments=None,
):
    """
    Send normal workflow notification based on status.

    Workflow:

    PENDING_SALESOPS_VALIDATION
        -> SalesOps

    PENDING_PM_VALIDATION
        -> PM / Ticket creator

    PM_REJECTED
        -> SalesOps

    SALESOPS_REJECTED
        -> PM / Ticket creator

    CLOSED
        -> SalesOps
    """

    attachments = attachments or []

    config = WORKFLOW_NOTIFICATION_CONFIG.get(status)

    if not config:
        return

    # --------------------------------------------------------
    # Prepare email body
    # --------------------------------------------------------

    body = config["body"](
        request,
        ticket,
        comments,
    )

    if not body:
        return

    # --------------------------------------------------------
    # Prepare subject
    # --------------------------------------------------------

    subject = (
        f"{ticket.ticket_number} - "
        f"{config['subject']}"
    )

    # --------------------------------------------------------
    # Prepare recipient
    # --------------------------------------------------------

    if config["recipient"] == PM_USER:

        creator = getattr(
            ticket,
            "meta_created_by",
            None,
        )

        if not creator:
            creator = getattr(
                ticket,
                "created_by",
                None,
            )

        to_emails = (
            getattr(creator, "email", "")
            if creator
            else ""
        )

    else:

        to_emails = prepare_emails_from_group(
            config["recipient"]
        )

    # --------------------------------------------------------
    # Prepare CC
    # --------------------------------------------------------

    cc = (
        ticket.email_cc
        if ticket.email_cc not in (
            None,
            "",
            "null",
        )
        else ""
    )

    # --------------------------------------------------------
    # Send email
    # --------------------------------------------------------

    if not to_emails:
        return

    if attachments:

        send_email_with_attachments(
            to=to_emails,
            subject=subject,
            body=body,
            cc=cc,
            attachments=attachments,
        )

    else:

        send_email(
            to=to_emails,
            subject=subject,
            body=body,
            cc=cc,
        )


