def _prepare_email_body_for_drbg_itcg(
    status,
    request,
    ticket,
    email_template,
    mail_links,
):
    """
    Prepare DRBG / ITCG announcement email body.
    """

    if status == TicketStatusChoices.ITCG_ANNOUNCEMENTS_COMPLETED:

        return prepare_itcg_announcement_body(
            request,
            ticket,
            email_template,
            mail_links,
        )

    if status in (
        TicketStatusChoices.PENDING_ITCG_ANNOUNCEMENTS,
        TicketStatusChoices.DRBG_ANNOUNCEMENTS_COMPLETED,
    ):

        return prepare_drbg_announcement_body(
            request,
            ticket,
            email_template,
            mail_links,
        )

    return ""


def _prepare_announcement_subject(
    status,
    ticket,
):
    """
    Prepare subject for DRBG / ITCG announcement emails.
    """

    ticket_number = ticket.ticket_number

    if status == TicketStatusChoices.ITCG_ANNOUNCEMENTS_COMPLETED:

        return (
            f"{ticket_number} - DR Announcements."
        )

    if status in (
        TicketStatusChoices.PENDING_ITCG_ANNOUNCEMENTS,
        TicketStatusChoices.DRBG_ANNOUNCEMENTS_COMPLETED,
    ):

        return (
            f"{ticket_number} - ER Announcements."
        )

    return (
        f"{ticket_number} - Price Setup for new request"
    )


def send_drbg_or_itcg_announcements(
    to_emails,
    status,
    request,
    ticket,
    email_template,
    cc_emails,
    mail_links,
    attachments=None,
):
    """
    Send DRBG / ITCG announcement email.

    Announcement emails are sent only when
    attachments are available.
    """

    attachments = attachments or []

    body = _prepare_email_body_for_drbg_itcg(
        status,
        request,
        ticket,
        email_template,
        mail_links,
    )

    if not to_emails or not body:
        return

    subject = _prepare_announcement_subject(
        status,
        ticket,
    )

    cc = (
        cc_emails
        if cc_emails not in (
            None,
            "",
            "null",
        )
        else ""
    )

    if attachments:

        send_email_with_attachments(
            to=to_emails,
            subject=subject,
            body=body,
            cc=cc,
            attachments=attachments,
        )


