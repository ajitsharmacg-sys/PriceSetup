def prepare_emails_from_group(group_name):
    """
    Prepare email recipients from a Django group.

    For SalesOps, CCI.Pricing notification email is also added.
    """

    if not group_name:
        return ""

    group = Group.objects.filter(name=group_name).first()

    if not group:
        return ""

    emails = list(
        UserModel.objects
        .filter(groups=group)
        .exclude(email="")
        .values_list("email", flat=True)
    )

    if group_name == SALES_OPS_USER:

        notification_group = (
            NotificationGroup.objects
            .filter(name="CCI.Pricing")
            .first()
        )

        if notification_group and notification_group.email:
            emails.append(notification_group.email)

    return ";".join(dict.fromkeys(emails))


