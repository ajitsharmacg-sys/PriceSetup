def handle_announcement_emails(
    request,
    ticket,
    status,
    attachments,
):
    """
    Handle DRBG and ITCG announcement emails.
    """

    post = request.POST

    # --------------------------------------------------------
    # DRBG
    # --------------------------------------------------------

    if status in (
        TicketStatusChoices.PENDING_ITCG_ANNOUNCEMENTS,
        TicketStatusChoices.DRBG_ANNOUNCEMENTS_COMPLETED,
    ):

        links = AnnouncementMailLink.objects.filter(
            user_type="DRBG"
        )

        send_drbg_or_itcg_announcements(
            post.get("drbg_to_emails"),
            status,
            request,
            ticket,
            post.get("drbg_email_template"),
            post.get("drbg_cc_emails"),
            links,
            attachments,
        )

    # --------------------------------------------------------
    # ITCG
    # --------------------------------------------------------

    if status == TicketStatusChoices.ITCG_ANNOUNCEMENTS_COMPLETED:

        links = AnnouncementMailLink.objects.filter(
            user_type="ITCG"
        )

        send_drbg_or_itcg_announcements(
            post.get("itcg_to_emails"),
            status,
            request,
            ticket,
            post.get("itcg_email_template"),
            post.get("itcg_cc_emails"),
            links,
            attachments,
        )


